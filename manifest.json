{
  "manifest_version": 3,
  "name": "BroadWorks Enhancer PJAX Preview",
  "version": "0.3.67",
  "description": "CommPilot 2.0 interface, PJAX navigation, admin helpers, and encrypted saved sign-ins.",
  "key": "",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "action": {
    "default_title": "CommPilot settings",
    "default_popup": "src/popup/popup.html"
  },
  "host_permissions": [
    "https://apps.avpaas.io/*",
    "https://apps01.avpaas.io/*",
    "https://apps02.avpaas.io/*",
    "https://apps-sbx.avpaas.io/*",
    "https://phone.tripbx.com/*",
    "https://phone1.tripbx.com/*",
    "https://phone2.tripbx.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "broadworks-enhancer-pjax@example.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "service_worker": "src/bg/credential-bridge.js",
    "scripts": ["src/bg/credential-bridge.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://apps.avpaas.io/commpilot/Login/*",
        "https://apps01.avpaas.io/commpilot/Login/*",
        "https://apps02.avpaas.io/commpilot/Login/*",
        "https://apps-sbx.avpaas.io/commpilot/Login/*",
        "https://phone.tripbx.com/commpilot/Login/*",
        "https://phone1.tripbx.com/commpilot/Login/*",
        "https://phone2.tripbx.com/commpilot/Login/*"
      ],
      "css": ["src/content/login.css"],
      "js": ["src/content/login.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://apps.avpaas.io/commpilot/*",
        "https://apps01.avpaas.io/commpilot/*",
        "https://apps02.avpaas.io/commpilot/*",
        "https://apps-sbx.avpaas.io/commpilot/*",
        "https://phone.tripbx.com/commpilot/*",
        "https://phone1.tripbx.com/commpilot/*",
        "https://phone2.tripbx.com/commpilot/*"
      ],
      "js": [
        "src/content/recovery-bridge.js",
        "src/content/logout-confirm.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://apps.avpaas.io/commpilot/*",
        "https://apps01.avpaas.io/commpilot/*",
        "https://apps02.avpaas.io/commpilot/*",
        "https://apps-sbx.avpaas.io/commpilot/*",
        "https://phone.tripbx.com/commpilot/*",
        "https://phone1.tripbx.com/commpilot/*",
        "https://phone2.tripbx.com/commpilot/*"
      ],
      "js": ["src/content/fonts.js", "src/content/theme-settings.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://apps.avpaas.io/commpilot/*",
        "https://apps01.avpaas.io/commpilot/*",
        "https://apps02.avpaas.io/commpilot/*",
        "https://apps-sbx.avpaas.io/commpilot/*",
        "https://phone.tripbx.com/commpilot/*",
        "https://phone1.tripbx.com/commpilot/*",
        "https://phone2.tripbx.com/commpilot/*"
      ],
      "js": [
        "src/content/stubguard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://apps.avpaas.io/commpilot/*",
        "https://apps01.avpaas.io/commpilot/*",
        "https://apps02.avpaas.io/commpilot/*",
        "https://apps-sbx.avpaas.io/commpilot/*",
        "https://phone.tripbx.com/commpilot/*",
        "https://phone1.tripbx.com/commpilot/*",
        "https://phone2.tripbx.com/commpilot/*"
      ],
      "js": [
        "src/content/pjax.js",
        "src/content/number-bulk.js",
        "src/content/profile-bulk.js",
        "src/content/number-activation-bulk.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://apps.avpaas.io/*",
        "https://apps01.avpaas.io/*",
        "https://apps02.avpaas.io/*",
        "https://apps-sbx.avpaas.io/*",
        "https://phone.tripbx.com/*",
        "https://phone1.tripbx.com/*",
        "https://phone2.tripbx.com/*"
      ],
      "css": [
        "src/content/enhancer.css",
        "src/content/native-pjax.css",
        "src/content/native-theme.css",
        "src/content/theme-palettes.css",
        "src/content/page-baseline.css",
        "src/content/menu-board.css",
        "src/content/forms.css",
        "src/content/theme-settings.css",
        "src/content/logout-confirm.css",
        "src/content/number-bulk.css"
      ],
      "js": [
        "src/content/enhancer.js",
        "src/content/native-theme.js",
        "src/content/theme-icons.js",
        "src/content/forms.js",
        "src/content/lists.js",
        "src/content/crumbs.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://apps.avpaas.io/commpilot/*",
        "https://apps01.avpaas.io/commpilot/*",
        "https://apps02.avpaas.io/commpilot/*",
        "https://apps-sbx.avpaas.io/commpilot/*",
        "https://phone.tripbx.com/commpilot/*",
        "https://phone1.tripbx.com/commpilot/*",
        "https://phone2.tripbx.com/commpilot/*"
      ],
      "css": ["src/content/native-help.css"],
      "js": ["src/content/native-help.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "src/bg/rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/help/help-content.json",
        "assets/fonts/InterVariable.woff2",
        "assets/fonts/GeistVariable.woff2",
        "assets/login/comm-pilot-women-transparent.png",
        "assets/icons/*.svg"
      ],
      "matches": [
        "https://apps.avpaas.io/*",
        "https://apps01.avpaas.io/*",
        "https://apps02.avpaas.io/*",
        "https://apps-sbx.avpaas.io/*",
        "https://phone.tripbx.com/*",
        "https://phone1.tripbx.com/*",
        "https://phone2.tripbx.com/*"
      ]
    }
  ]
}
