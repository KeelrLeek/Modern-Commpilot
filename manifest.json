{
  "manifest_version": 3,
  "name": "Modern CommPilot Skin",
  "version": "0.2.346",
  "version_name": "0.2.346-alpha",
  "description": "Cosmetic overlay that re-skins the CommPilot web app.",
  "icons": {},
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["https://*/commpilot/*"],

  "browser_specific_settings": {
    "gecko": {
      "id": "commpilot-skin@local"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://*/commpilot/*"],
      "js": ["src/content/fonts.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/commpilot/*"],
      "js": ["src/content/cloak.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/commpilot/*"],
      "js": ["src/content/stubguard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/commpilot/*"],
      "css": ["src/content/skin.css"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/commpilot/*"],
      "js": ["src/content/skin.js"],
      "all_frames": true,
      "run_at": "document_end"
    },
    {
      "matches": ["https://*/commpilot/*"],
      "js": ["src/content/pjax.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "src/bg/rules.json"
      }
    ]
  },

  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/*", "assets/icons/*", "assets/help/*"],
      "matches": ["https://*/*"]
    }
  ]
}
